<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="520.0" prefWidth="840.0" spacing="18.0"
      stylesheets="@../styles/global.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinalpae.controller.ProductoController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="22.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label styleClass="titulo-vista" text="Gestión de Productos" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Buscar por código, nombre o marca..." />
                <Button fx:id="btnRefrescar" mnemonicParsing="false" styleClass="btn-secundario" text="Refrescar" />
                <Button fx:id="btnEditarProducto" mnemonicParsing="false" styleClass="btn-secundario" text="Editar" />
                <Button fx:id="btnNuevoProducto" mnemonicParsing="false" styleClass="btn-primario" text="Nuevo Producto" />
            </children>
        </HBox>
        <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="95.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="175.0" text="Nombre" />
                <TableColumn fx:id="colMarca" prefWidth="95.0" text="Marca" />
                <TableColumn fx:id="colPrecio" prefWidth="95.0" text="Precio ($)" />
                <TableColumn fx:id="colCantidad" prefWidth="75.0" text="Stock" />
                <TableColumn fx:id="colColor" prefWidth="105.0" text="Color" />
                <TableColumn fx:id="colDescripcion" prefWidth="200.0" text="Descripción" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>