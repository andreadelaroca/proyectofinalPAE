<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectofinalpae.controller.LoginController"
            fitToWidth="true"
            fitToHeight="true"
            stylesheets="@../styles/global.css,@../styles/login.css"

    <content>
        <HBox prefHeight="600" prefWidth="900">

            <VBox alignment="CENTER"
                  spacing="20"
                  prefWidth="360"
                  styleClass="login-panel-izq">

                <Label text="BunBun Hub"
                       styleClass="login-marca"/>

                <Label text="Bienvenido a BunBun Hub"
                       styleClass="login-eslogan"/>
            </VBox>

            <VBox alignment="CENTER"
                  spacing="15"
                  prefWidth="540"
                  styleClass="login-panel-der">

                <Label text="Iniciar sesión"
                       styleClass="login-titulo"/>

                <TextField fx:id="txtUsuario"
                           promptText="Usuario"
                           maxWidth="340"
                           styleClass="login-input"/>

                <PasswordField fx:id="pwfPassword"
                               promptText="Contraseña"
                               maxWidth="340"
                               styleClass="login-input"/>

                <HBox alignment="CENTER" spacing="12">
                    <Button fx:id="btnIniciarSesion"
                            text="Ingresar"
                            styleClass="btn-primario"/>

                    <Button fx:id="btnLimpiar"
                            text="Limpiar"
                            styleClass="btn-secundario"/>
                </HBox>

                <Separator maxWidth="340"/>

                <Label text="Verificación de correo"
                       styleClass="subtitulo-seccion"/>

                <TextField fx:id="txtCodigo"
                           promptText="Código de 6 dígitos"
                           maxWidth="340"
                           styleClass="login-input"/>

                <HBox alignment="CENTER" spacing="10">
                    <Button text="Confirmar código"
                            onAction="#verificarCorreo"
                            styleClass="btn-primario"/>

                    <Button text="Reenviar código"
                            onAction="#reenviarCodigo"
                            styleClass="btn-secundario"/>
                </HBox>

                <Button text="Registrarme"
                        onAction="#abrirRegistro"
                        styleClass="btn-secundario"/>

                <Label fx:id="lblEstado"
                       wrapText="true"
                       maxWidth="340"
                       styleClass="mensaje-error"/>
            </VBox>

        </HBox>
    </content>
</ScrollPane>
