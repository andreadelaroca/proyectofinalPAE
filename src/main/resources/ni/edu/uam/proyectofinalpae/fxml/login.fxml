<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToHeight="true" fitToWidth="true" stylesheets="@../styles/global.css,@../styles/login.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.proyectofinalpae.controller.LoginController">

    <content>
        <HBox prefHeight="600" prefWidth="900">

            <VBox alignment="CENTER" prefWidth="360" spacing="20" styleClass="login-panel-izq">

                <Label styleClass="login-marca" text="BunBun Hub" />

                <Label styleClass="login-eslogan" text="Bienvenido a BunBun Hub" />
            </VBox>

            <VBox alignment="CENTER" spacing="15" styleClass="login-panel-der" HBox.hgrow="ALWAYS">

                <Label styleClass="login-titulo" text="Iniciar sesión" />

                <TextField fx:id="txtUsuario" maxWidth="340" promptText="Usuario" styleClass="login-input" />

                <PasswordField fx:id="pwfPassword" maxWidth="340" promptText="Contraseña" styleClass="login-input" />

                <HBox alignment="CENTER" spacing="12">

                    <Button fx:id="btnIniciarSesion" styleClass="btn-primario" text="Ingresar" />

                    <Button fx:id="btnLimpiar" styleClass="btn-secundario" text="Limpiar" />
                </HBox>

                <Separator maxWidth="340" />

                <Label styleClass="subtitulo-seccion" text="Verificación de correo" />

                <TextField fx:id="txtCodigo" maxWidth="340" promptText="Código de 6 dígitos" styleClass="login-input" />

                <HBox alignment="CENTER" spacing="10">

                    <Button onAction="#verificarCorreo" styleClass="btn-primario" text="Confirmar código" />

                    <Button onAction="#reenviarCodigo" styleClass="btn-secundario" text="Reenviar código" />
                </HBox>

                <Button onAction="#abrirRegistro" styleClass="btn-secundario" text="Registrarme" />

                <Label fx:id="lblEstado" maxWidth="340" styleClass="mensaje-error" wrapText="true" />
            </VBox>

        </HBox>
    </content>
</ScrollPane>
