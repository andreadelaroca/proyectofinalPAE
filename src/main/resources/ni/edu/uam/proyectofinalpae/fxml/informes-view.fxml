<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="520.0" prefWidth="840.0" spacing="18.0"
      stylesheets="@../styles/global.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinalpae.controller.InformesController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="22.0" />
    </padding>
    <children>
        <Label styleClass="titulo-vista" text="Generación de Informes" />
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="seccion-card">
            <padding>
                <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
            </padding>
            <children>
                <Label styleClass="label-campo" text="Desde:" />
                <DatePicker fx:id="dpDesde" prefHeight="36.0" prefWidth="116.0" />
                <Label styleClass="label-campo" text="Hasta:" />
                <DatePicker fx:id="dpHasta" prefHeight="36.0" prefWidth="116.0" />
                <Label styleClass="label-campo" text="Tipo:" />
                <ComboBox fx:id="cbTipoInforme" prefHeight="44.0" prefWidth="177.0" promptText="Seleccione tipo" />
                <Button fx:id="btnGenerarInforme" mnemonicParsing="false" styleClass="btn-primario" text="Generar Informe" />
            </children>
        </HBox>
        <TableView fx:id="tblInformes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colConcepto" prefWidth="240.0" text="Concepto" />
                <TableColumn fx:id="colValorTotal" prefWidth="180.0" text="Valor/Total" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>