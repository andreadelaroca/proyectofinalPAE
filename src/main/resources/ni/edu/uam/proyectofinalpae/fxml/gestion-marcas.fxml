<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="520.0" prefWidth="980.0" spacing="18.0"
      stylesheets="@../styles/global.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinalpae.controller.GestionMarcasController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="22.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label styleClass="titulo-vista" text="Gestión de Marcas" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtBuscar" prefWidth="260.0" promptText="Buscar por ID o nombre de marca..." />
                <Button fx:id="btnRefrescar" mnemonicParsing="false" styleClass="btn-secundario" text="Refrescar" />
                <Button fx:id="btnNuevaMarca" mnemonicParsing="false" styleClass="btn-primario" text="Nueva Marca" />
            </children>
        </HBox>
        <TableView fx:id="tblMarcas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="120.0" text="ID Marca" />
                <TableColumn fx:id="colNombre" prefWidth="780.0" text="Nombre de la Marca" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>