<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.proyectofinalpae.controller.NuevoPedidoController" fitToWidth="true">
    <content><VBox spacing="9" prefWidth="780" style="-fx-padding: 20;">
        <Label text="Nuevo Pedido" style="-fx-font-size: 20;"/>
        <ComboBox fx:id="cbCliente" promptText="cbCliente"/><ComboBox fx:id="cbColaborador" promptText="cbColaborador"/><DatePicker fx:id="dpFechaEntrega" promptText="dpFechaEntrega"/><TextField fx:id="txtDescripcion" promptText="txtDescripcion"/>
        <HBox spacing="10"><TextField fx:id="txtCodigoProducto" promptText="txtCodigoProducto"/><Button fx:id="btnBuscarProducto" text="Buscar producto"/><TextField fx:id="txtCantidad" promptText="txtCantidad"/><Button fx:id="btnAgregarProducto" text="Agregar"/></HBox>
        <Label fx:id="lblInfoProducto"/><TableView fx:id="tblDetalles" prefHeight="230"><columns><TableColumn fx:id="colCodigo" text="Código" prefWidth="110"/><TableColumn fx:id="colProducto" text="Producto" prefWidth="110"/><TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="110"/><TableColumn fx:id="colPrecioUnit" text="Precio" prefWidth="110"/><TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="110"/></columns></TableView>
        <Button fx:id="btnQuitarProducto" text="Quitar seleccionado"/><Label fx:id="lblTotal"/><Label fx:id="lblMensaje"/>
        <HBox spacing="10"><Button fx:id="btnGuardar" text="Guardar pedido"/><Button fx:id="btnCancelar" text="Cancelar"/></HBox>
    </VBox></content></ScrollPane>