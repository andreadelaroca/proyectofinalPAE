<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="980.0" spacing="20.0"
      stylesheets="@../styles/global.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinalpae.controller.ColaboradoresController">
    <padding>
        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label fx:id="lblTitulo" styleClass="titulo-vista" text="Nuevo Colaborador" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Buscar por nombre, usuario o correo..." />
                <Button fx:id="btnRefrescar" mnemonicParsing="false" styleClass="btn-secundario" text="Refrescar" />
                <Button fx:id="btnEditarColaborador" mnemonicParsing="false" styleClass="btn-secundario" text="Editar" />
                <Button fx:id="btnNuevoColaborador" mnemonicParsing="false" styleClass="btn-primario" text="Nuevo Colaborador" />
            </children>
        </HBox>

        <TableView fx:id="tblColaboradores" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombres" prefWidth="150.0" text="Nombres" />
                <TableColumn fx:id="colApellidos" prefWidth="150.0" text="Apellidos" />
                <TableColumn fx:id="colUsername" prefWidth="120.0" text="Usuario" />
                <TableColumn fx:id="colCorreo" prefWidth="190.0" text="Correo" />
                <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Teléfono" />
                <TableColumn fx:id="colDireccion" prefWidth="200.0" text="Dirección" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>