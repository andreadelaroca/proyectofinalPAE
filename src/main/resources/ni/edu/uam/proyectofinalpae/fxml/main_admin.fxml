<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="480.0" prefWidth="820.0" spacing="25.0" stylesheets="@../styles/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
    </padding>
    <children>
        <!-- Encabezado -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="titulo-vista" text="Panel de Administración" />
                        <Label text="Seleccione el módulo que desea abrir en una nueva ventana" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion" styleClass="btn-secundario" text="Cerrar Sesión" />
            </children>
        </HBox>

        <!-- Tarjetas con Iconos -->
        <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- Módulo Pedidos -->
                <VBox alignment="CENTER" maxHeight="230.0" onMouseClicked="#abrirPedidos" prefWidth="240.0" spacing="12.0" styleClass="modulo-card" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <ImageView fitHeight="64.0" fitWidth="64.0"
                                   onMouseClicked="#abrirPedidos"
                                   onMouseEntered="#agrandarIcono"
                                   onMouseExited="#restaurarIcono"
                                   pickOnBounds="true" preserveRatio="true" styleClass="icono-modulo">
                            <image>
                                <Image url="@../icons/shopping-bag.png" />
                            </image>
                        </ImageView>
                        <Label styleClass="titulo-card" text="Pedidos" />
                        <Label alignment="CENTER" text="Crear nuevos pedidos, consultar historial y actualizar estados." textAlignment="CENTER" wrapText="true" />
                    </children>
                </VBox>

                <!-- Módulo Clientes -->
                <VBox alignment="CENTER" maxHeight="230.0" onMouseClicked="#abrirClientes" prefWidth="240.0" spacing="12.0" styleClass="modulo-card" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <ImageView fitHeight="64.0" fitWidth="64.0"
                                   onMouseClicked="#abrirPedidos"
                                   onMouseEntered="#agrandarIcono"
                                   onMouseExited="#restaurarIcono"
                                   pickOnBounds="true" preserveRatio="true" styleClass="icono-modulo">
                            <image>
                                <Image url="@../icons/customer.png" />
                            </image>
                        </ImageView>
                        <Label styleClass="titulo-card" text="Clientes" />
                        <Label alignment="CENTER" text="Registrar nuevos clientes y administrar su información de contacto." textAlignment="CENTER" wrapText="true" />
                    </children>
                </VBox>

                <!-- Módulo Informes -->
                <VBox alignment="CENTER" maxHeight="230.0" onMouseClicked="#abrirInformes" prefWidth="240.0" spacing="12.0" styleClass="modulo-card" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <ImageView fitHeight="64.0" fitWidth="64.0"
                                   onMouseClicked="#abrirPedidos"
                                   onMouseEntered="#agrandarIcono"
                                   onMouseExited="#restaurarIcono"
                                   pickOnBounds="true" preserveRatio="true" styleClass="icono-modulo">
                            <image>
                                <Image url="@../icons/report.png" />
                            </image>
                        </ImageView>
                        <Label styleClass="titulo-card" text="Informes" />
                        <Label alignment="CENTER" text="Filtrar por rango de fechas y generar reportes del sistema." textAlignment="CENTER" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
