<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>

<TabPane prefHeight="540.0" prefWidth="800.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <tabs>
        <Tab text="Pedidos">
            <content>
                <fx:include fx:id="pedidosTab" source="pedidos-view.fxml" />
            </content>
        </Tab>
        <Tab text="Clientes">
            <content>
                <fx:include fx:id="clientesTab" source="clientes-view.fxml" />
            </content>
        </Tab>
        <Tab text="Informes">
            <content>
                <fx:include fx:id="informesTab" source="informes-view.fxml" />
            </content>
        </Tab>
    </tabs>
</TabPane>