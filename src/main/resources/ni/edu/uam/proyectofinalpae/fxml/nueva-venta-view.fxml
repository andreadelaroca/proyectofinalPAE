<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.proyectofinalpae.controller.NuevaVentaController" spacing="10" style="-fx-padding: 24;" stylesheets="@../styles/global.css">
    <Label text="Nueva venta" styleClass="titulo-vista"/>
    <Label text="Pedido a facturar (opcional: vacío = venta directa)" styleClass="label-campo"/><ComboBox fx:id="cbPedido" maxWidth="Infinity"/>
    <Label text="Cliente (opcional: vacío = consumidor final)" styleClass="label-campo"/><ComboBox fx:id="cbCliente" maxWidth="Infinity"/>
    <Label text="Colaborador" styleClass="label-campo"/><ComboBox fx:id="cbColaborador" maxWidth="Infinity"/>
    <Label text="Método de pago" styleClass="label-campo"/><ComboBox fx:id="cbMetodoPago" maxWidth="Infinity"/>
    <Label text="Producto" styleClass="label-campo"/><ComboBox fx:id="cbProducto" maxWidth="Infinity"/>
    <HBox spacing="10"><Label text="Cantidad"/><Spinner fx:id="spCantidad" editable="true" prefWidth="120"/><Button fx:id="btnAgregar" text="Agregar producto" styleClass="btn-secundario"/></HBox>
    <TextArea fx:id="txtDetalle" prefRowCount="5" promptText="Productos agregados" VBox.vgrow="ALWAYS"/>
    <Label fx:id="lblMensaje" wrapText="true" style="-fx-text-fill: #a32121;"/>
    <HBox spacing="10"><Button fx:id="btnGuardar" text="Registrar venta" styleClass="btn-primario"/><Button fx:id="btnCancelar" text="Cancelar" styleClass="btn-secundario"/></HBox>
</VBox>