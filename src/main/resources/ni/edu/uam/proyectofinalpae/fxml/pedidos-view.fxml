<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="520.0" prefWidth="980.0" spacing="18.0"
      stylesheets="@../styles/global.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinalpae.controller.GestionPedidosController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="22.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label styleClass="titulo-vista" text="Gestión de Pedidos" />
                <Region HBox.hgrow="ALWAYS" />
                <CheckBox fx:id="chkOcultarFinalizados" mnemonicParsing="false" text="Ocultar entregados/completados" />
                <TextField fx:id="txtBuscar" prefWidth="260.0" promptText="Buscar por ID, cliente, colaborador o estado..." />
                <Button fx:id="btnRefrescar" mnemonicParsing="false" styleClass="btn-secundario" text="Refrescar" />
                <Button fx:id="btnActualizarEstado" mnemonicParsing="false" styleClass="btn-secundario" text="Actualizar Estado" />
                <Button fx:id="btnNuevoPedido" mnemonicParsing="false" styleClass="btn-primario" text="Nuevo Pedido" />
            </children>
        </HBox>
        <TableView fx:id="tblPedidos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIdPedido" prefWidth="85.0" text="ID Pedido" />
                <TableColumn fx:id="colFechaCompra" prefWidth="115.0" text="Fecha Compra" />
                <TableColumn fx:id="colEstado" prefWidth="115.0" text="Estado" />
                <TableColumn fx:id="colTotal" prefWidth="90.0" text="Total" />
                <TableColumn fx:id="colDescripcion" prefWidth="260.0" text="Descripción" />
                <TableColumn fx:id="colUsuarioCliente" prefWidth="115.0" text="Cliente" />
                <TableColumn fx:id="colUsuarioColaborador" prefWidth="115.0" text="Colaborador" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>