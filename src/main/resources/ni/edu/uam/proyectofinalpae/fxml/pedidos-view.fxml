<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="520.0" prefWidth="840.0" spacing="18.0" stylesheets="@../styles/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="22.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label styleClass="titulo-vista" text="Gestión de Pedidos" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnNuevoPedido" mnemonicParsing="false" styleClass="btn-primario" text="Nuevo Pedido" />
                <Button fx:id="btnActualizarEstado" mnemonicParsing="false" styleClass="btn-secundario" text="Actualizar Estado" />
            </children>
        </HBox>
        <TableView fx:id="tblPedidos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIdPedido" prefWidth="92.0" text="ID Pedido" />
                <TableColumn fx:id="colFechaCompra" prefWidth="120.0" text="Fecha Compra" />
                <TableColumn fx:id="colEstado" prefWidth="79.0" text="Estado" />
                <TableColumn fx:id="colTotal" prefWidth="65.0" text="Total" />
                <TableColumn fx:id="colDescripcion" prefWidth="189.0" text="Descripción" />
                <TableColumn fx:id="colUsuarioCliente" prefWidth="113.0" text="Cliente" />
                <TableColumn fx:id="colUsuarioColaborador" prefWidth="125.0" text="Colaborador" />
            </columns>
        </TableView>
    </children>
</VBox>
