<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.proyectofinalpae.controller.MainAdminController" fitToWidth="true" fitToHeight="true"><content><VBox  spacing="9" alignment="TOP_LEFT" prefWidth="800" style="-fx-padding: 24;" >
    <Label text="Administración - Pedidos" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
    <TableView fx:id="tblPedidos" prefHeight="240"><columns>
        <TableColumn fx:id="colIdPedido" text="ID" prefWidth="110" />
        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110" />
        <TableColumn fx:id="colEstado" text="Estado" prefWidth="110" />
        <TableColumn fx:id="colTotal" text="Total" prefWidth="110" />
        <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="110" />
        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="110" />
        <TableColumn fx:id="colColaborador" text="Colaborador" prefWidth="110" />
    </columns></TableView><HBox spacing="10">
    <Button text="Nuevo pedido" onAction="#nuevoPedido"/>
    <Button text="Cambiar estado" onAction="#actualizarEstado"/>
    <Button text="Nuevo colaborador" onAction="#abrirColaboradores"/>
    <Button text="Productos" onAction="#abrirProductos"/><Button text="Ventas" onAction="#abrirVentas"/>
</HBox><Label text="Registrar cliente con SMTP" style="-fx-font-size: 17px; -fx-font-weight: bold;" /><TextField fx:id="txtRegUsuario" promptText="Usuario" maxWidth="400" /><PasswordField fx:id="txtRegPassword" promptText="Contraseña (mínimo 8)" maxWidth="400" /><TextField fx:id="txtPrimerNombre" promptText="Nombres" maxWidth="400" /><TextField fx:id="txtApellido" promptText="Apellidos" maxWidth="400" /><TextField fx:id="txtEmail" promptText="Correo" maxWidth="400" /><TextField fx:id="txtTelefono" promptText="Teléfono" maxWidth="400" /><TextField fx:id="txtDireccion" promptText="Dirección" maxWidth="400" /><Button fx:id="btnMapa" text="Elegir en OpenStreetMap" /><HBox spacing="10"><Button text="Registrar cliente" onAction="#guardarCliente" /><Button text="Limpiar" onAction="#limpiarFormularioCliente" /></HBox><Label text="Informes JasperReports - PDF de pedidos" style="-fx-font-size: 17px; -fx-font-weight: bold;" /><HBox spacing="10"><Label text="Desde"/><DatePicker fx:id="dpFechaInicio"/><Label text="Hasta"/><DatePicker fx:id="dpFechaFinal"/></HBox><ComboBox fx:id="cbTipoInforme" promptText="Tipo de informe" /><Button text="Generar PDF" onAction="#generarInforme" /><TableView fx:id="tblInformes" visible="false"><columns><TableColumn fx:id="colConcepto" /><TableColumn fx:id="colValor" /></columns></TableView>
</VBox></content></ScrollPane>
