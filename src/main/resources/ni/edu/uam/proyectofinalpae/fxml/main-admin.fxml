<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1180.0"
            stylesheets="@../styles/global.css"
            styleClass="panel-admin"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectofinalpae.controller.MainAdminController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="barra-superior">
            <padding>
                <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
            </padding>
            <children>
                <Label styleClass="titulo-barra" text="BunBun Hub" />
                <Label styleClass="subtitulo-barra" text="Panel de administración" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="btn-barra" text="Cerrar sesión" />
            </children>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="tabPrincipal" styleClass="tabs-admin" tabClosingPolicy="SELECTED_TAB">
            <tabs>
                <Tab closable="false" text="Pedidos">
                    <content>
                        <fx:include source="pedidos-view.fxml" />
                    </content>
                </Tab>
                <Tab closable="false" text="Ventas">
                    <content>
                        <fx:include source="ventas-view.fxml" />
                    </content>
                </Tab>
                <Tab closable="false" text="Productos">
                    <content>
                        <fx:include source="productos-view.fxml" />
                    </content>
                </Tab>
                <Tab closable="false" text="Marcas">
                    <content>
                        <fx:include source="gestion-marcas.fxml" />
                    </content>
                </Tab>
                <Tab closable="false" text="Clientes">
                    <content>
                        <fx:include source="clientes-view.fxml" />
                    </content>
                </Tab>
                <Tab closable="false" text="Colaboradores">
                    <content>
                        <fx:include source="colaboradores-view.fxml" />
                    </content>
                </Tab>
                <Tab closable="false" text="Informes">
                    <content>
                        <fx:include source="informes-view.fxml" />
                    </content>
                </Tab>
                <Tab closable="false" text="Tipo de cambio">
                    <content>
                        <fx:include source="tipo-cambio-view.fxml" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
