<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.proyectofinalpae.controller.NuevoColaboradorController" fitToWidth="true" fitToHeight="true"><content><VBox  spacing="9" alignment="TOP_LEFT" prefWidth="800" style="-fx-padding: 24;" >
    <Label text="Nuevo colaborador" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
    <TextField fx:id="txtNombres" promptText="Nombres" maxWidth="400" />
    <TextField fx:id="txtApellidos" promptText="Apellidos" maxWidth="400" />
    <TextField fx:id="txtUsername" promptText="Usuario" maxWidth="400" />
    <TextField fx:id="txtTelefono" promptText="Teléfono" maxWidth="400" />
    <TextField fx:id="txtCorreo" promptText="Correo electrónico" maxWidth="400" />
    <PasswordField fx:id="pfPassword" promptText="Contraseña (mínimo 8)" maxWidth="400" />
    <PasswordField fx:id="pfConfirmarPassword" promptText="Repetir contraseña" maxWidth="400" />
    <TextArea fx:id="txtDireccion" promptText="Dirección" maxWidth="400" />
    <HBox spacing="10"><Button text="Guardar" fx:id="btnGuardar" />
        <Button text="Cancelar" fx:id="btnCancelar" />
    </HBox>
    <Label fx:id="lblMensaje" wrapText="true" />
</VBox></content></ScrollPane>