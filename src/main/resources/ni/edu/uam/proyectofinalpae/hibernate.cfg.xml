<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Credenciales y conexión a PostgreSQL -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/proyectofinalPAE</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">1234</property>

        <!-- Configuración del motor Hibernate -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">validate</property>

        <!-- Mapeo de Entidades asignadas a Andrés -->
        <mapping class="ni.edu.uam.proyectofinalpae.models.inventario.Lote"/>
        <mapping class="ni.edu.uam.proyectofinalpae.models.inventario.AuditoriaMovimiento"/>
        <mapping class="ni.edu.uam.proyectofinalpae.models.agenda.Cliente"/>
    </session-factory>
</hibernate-configuration>