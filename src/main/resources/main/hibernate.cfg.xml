<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/nombre_tu_db</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">tu_password</property>
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">validate</property>

        <!-- Mapeo Entidades Seguridad -->
        <mapping class="ni.edu.uam.proyectofinalpae.models.seguridad.Usuario"/>

        <!-- Mapeo Entidades Inventario -->
        <mapping class="ni.edu.uam.proyectofinalpae.models.inventario.Categoria"/>
        <mapping class="ni.edu.uam.proyectofinalpae.models.inventario.Marca"/>
        <mapping class="ni.edu.uam.proyectofinalpae.models.inventario.Producto"/>
        <mapping class="ni.edu.uam.proyectofinalpae.models.inventario.Lote"/>
        <mapping class="ni.edu.uam.proyectofinalpae.models.inventario.AuditoriaMovimiento"/>

        <!-- Mapeo Entidades Agenda -->
        <mapping class="ni.edu.uam.proyectofinalpae.models.agenda.Cliente"/>
        <mapping class="ni.edu.uam.proyectofinalpae.models.agenda.Servicio"/>
        <mapping class="ni.edu.uam.proyectofinalpae.models.agenda.Cita"/>
        <mapping class="ni.edu.uam.proyectofinalpae.models.agenda.ConsumoInsumo"/>
    </session-factory>
</hibernate-configuration>